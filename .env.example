# Copy to .env — every variable is optional in development.

# Port the API (and the built app) listens on.
PORT=3200

# Where the SQLite database lives.
DATA_FILE=data/app.db

# REQUIRED in production (NODE_ENV=production refuses to boot without it).
# Any long random string; whoever knows it can mint tokens for any account.
JWT_SECRET=

# Token lifetime in seconds (default: 1 day).
TOKEN_TTL_SECONDS=86400

# Set to "true" only when running behind a reverse proxy, so the auth rate
# limit sees real client addresses instead of the proxy's.
TRUST_PROXY=false

# Auth rate limit: RATE_LIMIT=off disables, RATE_LIMIT_AUTH sets attempts/min/IP.
RATE_LIMIT=on
RATE_LIMIT_AUTH=10

{
  "name": "simple-task-manager",
  "version": "1.0.0",
  "description": "Multi-user task manager (bolttech challenge) — the simple cut: one package, SQLite only, Vue UI",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "node --watch server/server.js",
    "dev:web": "vite",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "vitest run",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "vue": "^3.5.13",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
